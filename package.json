{
  "name": "trunk-based-dev",
  "version": "0.1.0",
  "description": "Minimal repo for testing trunk-based development and CI/CD pipelines",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "encore run",
    "build": "encore build",
    "test": "vitest",
    "test:run": "bun run scripts/test-run.ts",
    "test:e2e": "playwright test",
    "typecheck": "bash scripts/typecheck.sh",
    "db:migrate": "bun run scripts/db-migrate.ts",
    "lint": "biome check .",
    "lint:fix": "biome check . --write --unsafe",
    "format": "biome check . --write",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "validate:production": "bun run scripts/validate-deployment.ts production"
  },
  "dependencies": {
    "encore.dev": "^1.56.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@changesets/cli": "^2.29.8",
    "@playwright/test": "^1.58.1",
    "@types/bun": "^1.3.9",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.3"
}
